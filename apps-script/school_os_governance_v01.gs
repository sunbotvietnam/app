const SCHOOL_OS_PROPOSAL_HEADERS=['proposal_id','school_name','region','school_type','source','reason','contact_hint','proposed_by_user_id','team_id','proposed_owner_user_id','duplicate_status','status','admin_note','approved_by_user_id','approved_at','created_at','updated_at','record_version','deleted_at','source_detail'];
function ensureGovernanceSheets_(ss){ensureSheet_(ss,'SO_SCHOOL_PROPOSALS',SCHOOL_OS_PROPOSAL_HEADERS);ensureColumns_(ss.getSheetByName('SO_SCHOOL_PROPOSALS'),SCHOOL_OS_PROPOSAL_HEADERS);}
function normalizeSchoolKey_(name){return String(name||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/[^a-z0-9]+/g,' ').trim();}
function duplicateSchoolCheck_(name,region){const key=normalizeSchoolKey_(name),reg=String(region||'').trim().toLowerCase();if(!key)return{status:'CHUA_DU_DU_LIEU',matches:[]};const matches=activeObjects_(SCHOOL_OS.SHEETS.SCHOOLS).filter(s=>{const sk=normalizeSchoolKey_(s.school_name);return(sk===key||(sk&&key&&(sk.indexOf(key)>=0||key.indexOf(sk)>=0)))&&(!reg||String(s.region||'').trim().toLowerCase()===reg);}).slice(0,5).map(s=>({school_id:String(s.school_id),school_name:String(s.school_name),region:String(s.region),status:String(s.status)}));return{status:matches.length?'CO_KHA_NANG_TRUNG':'KHONG_THAY_TRUNG',matches:matches};}
function listSchoolProposalsApi_(body,auth){let rows=activeObjects_('SO_SCHOOL_PROPOSALS');if(String(auth.user.role)==='LEADER')rows=rows.filter(x=>String(x.team_id||'')===String(auth.user.team_id||''));else if(String(auth.user.role)==='STAFF')rows=rows.filter(x=>String(x.proposed_by_user_id||'')===String(auth.user.user_id));rows.sort((a,b)=>new Date(b.updated_at||b.created_at)-new Date(a.updated_at||a.created_at));return{success:true,proposals:rows.map(mapProposalOut_)};}
function submitSchoolProposalApi_(body,auth){const d=body.proposal||body.record||{},name=clean_(d.school_name||d.name),region=clean_(d.region);if(!name)throw new Error('Cần nhập tên trường.');const dupe=duplicateSchoolCheck_(name,region),leader=defaultProposalLeader_(auth.user),ownerId=clean_(d.proposed_owner_user_id)||String((leader||{}).user_id||'');if(ownerId){const target=findUserById_(ownerId);if(!target||String(target.status).toUpperCase()!=='ACTIVE')throw new Error('Người phụ trách đề xuất không hợp lệ.');if(String(auth.user.role)==='LEADER'&&String(target.user_id)!==String(auth.user.user_id))throw new Error('Leader chỉ đề xuất trường về nhóm của mình.');if(String(auth.user.role)==='STAFF'&&String(target.user_id)!==String((leader||{}).user_id))throw new Error('Staff không được chuyển đề xuất sang nhóm khác.');}const id='PRP'+Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Bangkok','yyyyMMddHHmmss')+Math.floor(Math.random()*900+100),values={proposal_id:id,school_name:name,region:region,school_type:clean_(d.school_type||d.type),source:clean_(d.source),reason:clean_(d.reason),contact_hint:clean_(d.contact_hint),proposed_by_user_id:auth.user.user_id,team_id:leader?leader.team_id:(d.team_id||''),proposed_owner_user_id:ownerId,duplicate_status:dupe.status,status:'CHO_DUYET',admin_note:'',approved_by_user_id:'',approved_at:'',created_at:new Date(),updated_at:new Date(),record_version:1,deleted_at:'',source_detail:clean_(d.source_detail)};const sh=getDataSpreadsheet_().getSheetByName('SO_SCHOOL_PROPOSALS'),headers=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);sh.appendRow(headers.map(h=>values[h]!==undefined?values[h]:''));logEvent_({school_id:'',school_name:name,event_type:'SCHOOL_PROPOSAL_SUBMITTED',actor:auth.user.email,channel:'System',summary:'Đề xuất trường mới: '+name,detail:{proposal_id:id,duplicate_status:dupe.status},source_id:id,hot_signal:false});return{success:true,proposal:mapProposalOut_(values),duplicate_check:dupe};}
function reviewSchoolProposalApi_(body,auth){if(String(auth.user.role)!=='ADMIN')throw new Error('Chỉ Admin được duyệt đề xuất trường.');const id=clean_(body.proposal_id),decision=String(body.decision||'').toUpperCase(),rec=findRecord_('SO_SCHOOL_PROPOSALS','proposal_id',id);if(!rec||rec.obj.deleted_at)throw new Error('Không tìm thấy đề xuất.');if(['APPROVE','REJECT','NEED_INFO'].indexOf(decision)<0)throw new Error('Quyết định không hợp lệ.');if(decision==='REJECT'||decision==='NEED_INFO'){const status=decision==='REJECT'?'TU_CHOI':'CAN_BO_SUNG';setObjectFields_(rec.sheet,rec.row,{status:status,admin_note:clean_(body.admin_note),updated_at:new Date(),record_version:Number(rec.obj.record_version||0)+1});return{success:true,status:status};}
const ownerId=clean_(body.owner_user_id||rec.obj.proposed_owner_user_id),owner=findUserById_(ownerId);if(!owner||String(owner.status).toUpperCase()!=='ACTIVE'||String(owner.role)!=='LEADER')throw new Error('Admin cần chọn một Leader đang hoạt động để nhận trường.');const dupe=duplicateSchoolCheck_(rec.obj.school_name,rec.obj.region);if(dupe.matches.length&&!body.confirm_duplicate)throw new Error('DUPLICATE_CONFIRM_REQUIRED');const schoolId='SCH'+Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Bangkok','yyyyMMddHHmmss')+Math.floor(Math.random()*900+100),values={school_id:schoolId,school_name:rec.obj.school_name,region:rec.obj.region,school_type:rec.obj.school_type,status:'Chưa tiếp cận',owner:owner.name,owner_user_id:owner.user_id,team_id:owner.team_id||'',next_action:'Xác minh đầu mối và lập kế hoạch tiếp cận',next_action_date:'',risk:'Bình thường',source:rec.obj.source||'Đề xuất nội bộ',children:'',steam_status:'',policy_status:'',renewal_date:'',updated_at:new Date()};const created=mutateRecord_(SCHOOL_OS.SHEETS.SCHOOLS,'school_id',schoolId,values,0,auth.user,'SCHOOL_APPROVED');setObjectFields_(rec.sheet,rec.row,{status:'DA_DUYET',admin_note:clean_(body.admin_note),approved_by_user_id:auth.user.user_id,approved_at:new Date(),updated_at:new Date(),record_version:Number(rec.obj.record_version||0)+1});logEvent_({school_id:schoolId,school_name:rec.obj.school_name,event_type:'SCHOOL_PROPOSAL_APPROVED',actor:auth.user.email,channel:'System',summary:'Admin đã duyệt trường và giao '+owner.name,detail:{proposal_id:id,owner_user_id:owner.user_id,team_id:owner.team_id},source_id:id,hot_signal:false});return{success:true,school:created.record,proposal_status:'DA_DUYET'};}
function mapProposalOut_(r){return{proposal_id:String(r.proposal_id||''),school_name:String(r.school_name||''),region:String(r.region||''),school_type:String(r.school_type||''),source:String(r.source||''),reason:String(r.reason||''),contact_hint:String(r.contact_hint||''),proposed_by_user_id:String(r.proposed_by_user_id||''),team_id:String(r.team_id||''),proposed_owner_user_id:String(r.proposed_owner_user_id||''),duplicate_status:String(r.duplicate_status||''),status:String(r.status||''),admin_note:String(r.admin_note||''),approved_by_user_id:String(r.approved_by_user_id||''),approved_at:r.approved_at||'',created_at:r.created_at||'',updated_at:r.updated_at||'',record_version:Number(r.record_version||0),source_detail:String(r.source_detail||'')};}
function applySchoolWorkflowEvent_(schoolId,eventType,detail,actor){if(!schoolId)return;const rec=findRecord_(SCHOOL_OS.SHEETS.SCHOOLS,'school_id',schoolId);if(!rec||rec.obj.deleted_at)return;const current=String(rec.obj.status||''),special=/triển khai|đã chốt|gia hạn|tạm dừng|không ưu tiên|không thành công|sáp nhập|chuyển đầu mối/i.test(current);if(special)return;let next='';switch(String(eventType||'').toUpperCase()){case'EMAIL_SENT':case'EMAIL_DRAFT_CREATED':if(/^(Chưa tiếp cận|Đang tiếp cận|Tiềm năng)$/i.test(current))next='Đang chờ phản hồi';break;case'LINK_OPENED':if(/^(Chưa tiếp cận|Đang tiếp cận|Tiềm năng|Đang chờ phản hồi)$/i.test(current))next='Có tín hiệu quan tâm';break;case'SCHOOL_REPLIED':next='Đã phản hồi';break;case'MEETING_SCHEDULED':next='Đã hẹn trao đổi';break;case'OPPORTUNITY_UPDATED':const stage=String((detail||{}).stage||'');if(/won|đã chốt/i.test(stage))next='Đã chốt';else if(/đề xuất/i.test(stage))next='Đang đề xuất';else next='Có cơ hội';break;}if(!next||next===current)return;setObjectFields_(rec.sheet,rec.row,{status:next,updated_at:new Date(),updated_by:(actor&&actor.email)||'workflow',record_version:Number(rec.obj.record_version||0)+1});logEvent_({school_id:schoolId,school_name:rec.obj.school_name,event_type:'SCHOOL_STATUS_AUTO_UPDATED',actor:(actor&&actor.email)||'workflow',channel:'System',summary:'Tự cập nhật trạng thái: '+current+' → '+next,detail:{from:current,to:next,trigger:eventType},source_id:schoolId,hot_signal:false});}
